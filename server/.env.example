PORT=5000
MONGODB_URI=mongodb://localhost:27017/valora_v1
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Internal Django ML microservice
ML_SERVICE_URL=http://localhost:8000/api/ml

# SMTP (Nodemailer) — for local dev/demo, use a free Ethereal sandbox
# account instead of a real provider (no signup, catches mail without
# delivering it anywhere real). Generate one:
#   node -e "import('nodemailer').then(async ({default:n})=>console.log(await n.createTestAccount()))"
# Then set SMTP_HOST=smtp.ethereal.email, SMTP_USER/SMTP_PASS from the
# output, SMTP_FROM = same as SMTP_USER. sendMail() logs a preview URL for
# every email — see README's Email section. For an actual deployment, swap
# in a real provider (Gmail app password, SendGrid, Mailtrap, etc.).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
